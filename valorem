                <h2 class="section-title">Depoimentos & Cases</h2>
            </div>

            <div class="depoimentos-grid">
                <div class="depoimento-card"><em>"Depoimento de cliente aqui"</em></div>
                <div class="depoimento-card"><em>"Depoimento de cliente aqui"</em></div>
                <div class="depoimento-card"><em>"Depoimento de cliente aqui"</em></div>
            </div>
        </div>
