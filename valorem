<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Valorem Consultoria | Método VLR</title>
    
    <!-- Favicon / Logo na Aba do Navegador -->
    <link rel="icon" type="image/png" href="logo.png">

    <!-- Meta Tags para pré-visualização no WhatsApp e Redes Sociais -->
    <meta property="og:title" content="Valorem Consultoria | Método VLR">
    <meta property="og:description" content="Resultado não precisa ser construído às custas das pessoas. Consultoria em Estratégia, Liderança e Resultados.">
    <meta property="og:image" content="logo.png">
    <meta property="og:type" content="website">

    <!-- Fonte Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-navy: #0A192F;
            --accent-green: #84CC16;
            --accent-green-hover: #65A30D;
            --accent-blue: #0284C7;
            --bg-light: #F8FAFC;
            --bg-card: #FFFFFF;
            --text-main: #1E293B;
            --text-muted: #64748B;
            --border-color: #E2E8F0;
            --shadow-md: 0 10px 25px -5px rgba(10, 25, 47, 0.08);
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text-main);
            background-color: var(--bg-light);
            line-height: 1.6;
            overflow-x: hidden;
        }

        a { text-decoration: none; color: inherit; }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* HEADER */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: rgba(10, 25, 47, 0.95);
            backdrop-filter: blur(8px);
            z-index: 1000;
            border-bottom: 2px solid var(--accent-green);
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 75px;
        }

        .logo-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-img {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            object-fit: cover;
        }

        .logo-text {
            display: flex;
            flex-direction: column;
        }

        .logo-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: #FFFFFF;
            letter-spacing: 1px;
        }

        .logo-tagline {
            font-size: 0.7rem;
            color: var(--accent-green);
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .nav-links {
            display: flex;
            gap: 20px;
        }

        .nav-links a {
            color: #CBD5E1;
            font-size: 0.9rem;
            font-weight: 500;
            transition: var(--transition);
        }

        .nav-links a:hover {
            color: var(--accent-green);
        }

        /* SEÇÃO 1 — HERO / CAPA (Estilo Apresentação) */
        .hero {
            background: linear-gradient(135deg, #0A192F 0%, #0F172A 100%);
            color: #FFFFFF;
            padding: 140px 0 90px 0;
            text-align: center;
            position: relative;
        }

        .hero-logo-center {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            margin: 0 auto 20px auto;
            border: 3px solid var(--accent-green);
            padding: 4px;
            background-color: #FFFFFF;
        }

        .hero h1 {
            font-size: 2.25rem;
            font-weight: 800;
            max-width: 850px;
            margin: 0 auto 16px auto;
            line-height: 1.3;
        }

        .hero p {
            font-size: 1.1rem;
            color: #94A3B8;
            max-width: 750px;
            margin: 0 auto 30px auto;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 14px 32px;
            background-color: var(--accent-green);
            color: var(--primary-navy);
            font-weight: 700;
            font-size: 1rem;
            border-radius: 50px;
            transition: var(--transition);
            box-shadow: 0 4px 15px rgba(132, 204, 22, 0.3);
        }

        .btn:hover {
            background-color: var(--accent-green-hover);
            transform: translateY(-2px);
            color: #FFFFFF;
        }

        /* SEÇÃO 2 — SOBRE MIM */
        .sobre {
            padding: 80px 0;
            background-color: #FFFFFF;
        }

        .sobre-content {
            max-width: 850px;
            margin: 0 auto;
        }

        .sobre p {
            font-size: 1.05rem;
            color: var(--text-main);
            margin-bottom: 18px;
        }

        .desalinhamento-box {
            background-color: var(--bg-light);
            border-left: 4px solid var(--accent-green);
            padding: 20px 24px;
            border-radius: 0 8px 8px 0;
            margin: 24px 0;
        }

        .desalinhamento-box p {
            font-weight: 600;
            color: var(--primary-navy);
            margin-bottom: 8px;
        }

        .desalinhamento-box p:last-child { margin-bottom: 0; }

        /* SEÇÃO 3 — MÉTODO VLR (INFOGRÁFICO CONECTADO) */
        .metodo {
            padding: 80px 0;
            background-color: var(--bg-light);
        }

        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title {
            font-size: 1.85rem;
            font-weight: 800;
            color: var(--primary-navy);
        }

        /* Infográfico de Círculos com Conectores */
        .vlr-diagram {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            margin-bottom: 40px;
        }

        .vlr-diagram::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 20%;
            right: 20%;
            height: 4px;
            background-color: var(--accent-green);
            z-index: 1;
            transform: translateY(-50%);
        }

        .vlr-circle-item {
            position: relative;
            z-index: 2;
            background: #FFFFFF;
            width: 110px;
            height: 110px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
            font-weight: 800;
            margin: 0 40px;
            box-shadow: var(--shadow-md);
            border: 4px solid var(--border-color);
            transition: var(--transition);
        }

        .vlr-circle-item.v { border-color: var(--accent-blue); color: var(--accent-blue); }
        .vlr-circle-item.l { border-color: var(--accent-green); color: var(--accent-green); }
        .vlr-circle-item.r { border-color: var(--primary-navy); color: var(--primary-navy); }

        .vlr-circle-item:hover { transform: scale(1.1); }

        .vlr-cards-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .vlr-card {
            background: var(--bg-card);
            border-radius: 12px;
            padding: 28px 20px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-md);
            text-align: center;
            transition: var(--transition);
        }

        .vlr-card:hover {
            transform: translateY(-5px);
            border-color: var(--accent-green);
        }

        .vlr-card h3 {
            font-size: 1.2rem;
            color: var(--primary-navy);
            margin-bottom: 12px;
            font-weight: 700;
        }

        .vlr-card p {
            font-size: 0.95rem;
            color: var(--text-muted);
        }

        .metodo-footer-quote {
            text-align: center;
            margin-top: 36px;
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--primary-navy);
            font-style: italic;
        }

        /* SEÇÃO 4 — ÁREAS DE ATUAÇÃO (Cards com Hexágono) */
        .atuacao {
            padding: 80px 0;
            background-color: #FFFFFF;
        }

        .atuacao-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .atuacao-card {
            background-color: var(--bg-light);
            border: 1px solid var(--border-color);
            padding: 22px 16px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--primary-navy);
            display: flex;
            align-items: center;
            gap: 12px;
            transition: var(--transition);
        }

        .atuacao-card:hover {
            background-color: var(--primary-navy);
            color: #FFFFFF;
            transform: translateY(-3px);
        }

        .atuacao-card span {
            color: var(--accent-green);
            font-size: 1.2rem;
        }

        /* SEÇÃO 5 — DEPOIMENTOS */
        .depoimentos {
            padding: 80px 0;
            background-color: var(--bg-light);
        }

        .depoimentos-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .depoimento-card {
            background-color: var(--bg-card);
            border: 2px dashed #CBD5E1;
            padding: 36px 20px;
            border-radius: 10px;
            text-align: center;
            color: var(--text-muted);
            min-height: 180px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* SEÇÃO 6 — CONTATO */
        .contato {
            padding: 80px 0;
            background: linear-gradient(135deg, var(--primary-navy) 0%, #0F172A 100%);
            color: #FFFFFF;
        }

        .contato-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            align-items: start;
        }

        .contato-info h2 {
            font-size: 1.6rem;
            line-height: 1.35;
            margin-bottom: 20px;
            color: #FFFFFF;
        }

        .contato-info p {
            color: #94A3B8;
            margin-bottom: 30px;
            font-size: 1.05rem;
        }

        .contact-actions {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .btn-outline {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 28px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 50px;
            color: #FFFFFF;
            font-weight: 600;
            transition: var(--transition);
        }

        .btn-outline:hover {
            border-color: var(--accent-green);
            color: var(--accent-green);
        }

        .form-grupo {
            margin-bottom: 16px;
        }

        .form-grupo label {
            display: block;
            margin-bottom: 6px;
            font-size: 0.85rem;
            color: #CBD5E1;
        }

        .form-grupo input, .form-grupo textarea {
            width: 100%;
            padding: 12px;
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 6px;
            color: #FFFFFF;
            font-family: inherit;
        }

        .form-grupo input:focus, .form-grupo textarea:focus {
            outline: none;
            border-color: var(--accent-green);
        }

        /* FOOTER */
        footer {
            background-color: #030712;
            padding: 24px 0;
            text-align: center;
            color: var(--text-muted);
            font-size: 0.85rem;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* RESPONSIVIDADE */
        @media (max-width: 900px) {
            .vlr-cards-grid, .depoimentos-grid, .contato-wrapper { grid-template-columns: 1fr; }
            .atuacao-grid { grid-template-columns: repeat(2, 1fr); }
            .vlr-diagram { flex-direction: column; gap: 20px; }
            .vlr-diagram::before { display: none; }
            .vlr-circle-item { margin: 0; }
            .nav-links { display: none; }
        }

        @media (max-width: 600px) {
            .atuacao-grid { grid-template-columns: 1fr; }
            .hero h1 { font-size: 1.6rem; }
        }
    </style>
</head>
<body>

    <!-- HEADER / NAVEGAÇÃO -->
    <header>
        <div class="container nav-container">
            <div class="logo-brand">
